# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# Default OpenRouter model
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxx

# Default Groq model (optional)
GROQ_MODEL=llama-3.3-70versatitle

# AI Provider: openrouter | groq | gemini
AI_PROVIDER=openrouter

# Gemini API Key (Google AI Studio)
# GEMINI_API_KEY=xxxxxxxxxxxxx
# Model examples:
# - gemini-1.5-flash
# - gemini-1.5-flash-latest
# GEMINI_MODEL=gemini-1.5-flash
# API version: v1 or v1beta (if empty, auto-picked based on model name)
# GEMINI_API_VERSION=v1beta
# Optional: cache TTL for ListModels (ms)
# GEMINI_MODELS_CACHE_TTL_MS=600000

# Firebase Admin SDK service account JSON (one-line JSON)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Port (Railway sets this automatically, but useful for local dev)
# PORT=3000
